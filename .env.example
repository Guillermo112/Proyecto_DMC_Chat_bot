# Copia este archivo como .env (en la raíz del proyecto) y ajusta los valores.
# .env no se versiona; no pongas secretos en .env.example.

# Ruta de la base SQLite (relativa a la raíz del proyecto o absoluta)
ANTICIPA_DB_PATH=db/anticipa.db

# Paginación de listar_facturas
LIMITE_POR_DEFECTO=20
LIMITE_MAXIMO=100

# SMTP para enviar el código OTP (ej. Gmail: smtp.gmail.com, 587 y una
# "contraseña de aplicación" de 16 caracteres, no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=

# Correos reales del equipo para recibir el OTP en la demo (uno por integrante).
# db/generar_datos.py reparte los clientes 1-13 en rotación:
#   1 -> clientes 1, 6, 11 | 2 -> 2, 7, 12 | 3 -> 3, 8, 13 | 4 -> 4, 9 | 5 -> 5, 10
# Vacío = esos clientes quedan con facturacion@clienteNN.example. NOMBRE_PRUEBA_n es
# opcional (contacto mostrado). Regenera la base al cambiarlos.
CORREO_PRUEBA_1=
CORREO_PRUEBA_2=
CORREO_PRUEBA_3=
CORREO_PRUEBA_4=
CORREO_PRUEBA_5=
NOMBRE_PRUEBA_1=
NOMBRE_PRUEBA_2=
NOMBRE_PRUEBA_3=
NOMBRE_PRUEBA_4=
NOMBRE_PRUEBA_5=

OTP_MINUTOS_VALIDEZ=10
OTP_MAX_INTENTOS=3
OTP_ESPERA_REENVIO_SEG=60

# Secreto para el HMAC del código OTP y para firmar el token de sesión (JWT).
# Genera uno propio, no lo compartas ni lo versiones:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarlo invalida las sesiones abiertas y los códigos pendientes.
AUTH_SECRET=
# Duración de la sesión tras verificar el código (minutos). Sin logout por ahora.
AUTH_MINUTOS_SESION=30

# Entorno: "dev" expone el CRUD de desarrollo /api/... SIN autenticación (Postman).
# Cualquier otro valor, o no definirlo, lo oculta: quedan /health, /auth y /mi.
ENTORNO=dev
