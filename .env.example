# Copia este archivo como .env (en la raíz del proyecto) y ajusta los valores.
# .env no se versiona; no pongas secretos en .env.example.

# Ruta de la base SQLite (relativa a la raíz del proyecto o absoluta)
ANTICIPA_DB_PATH=db/anticipa.db

# Paginación de listar_facturas
LIMITE_POR_DEFECTO=20
LIMITE_MAXIMO=100

# SMTP para enviar el código OTP (ej. Gmail: smtp.gmail.com, 587 y una
# "contraseña de aplicación" de 16 caracteres, no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=

# Correos reales del equipo para recibir el OTP en la demo (uno por integrante).
# db/generar_datos.py reparte los clientes 1-13 en rotación:
#   1 -> clientes 1, 6, 11 | 2 -> 2, 7, 12 | 3 -> 3, 8, 13 | 4 -> 4, 9 | 5 -> 5, 10
# Vacío = esos clientes quedan con facturacion@clienteNN.example. NOMBRE_PRUEBA_n es
# opcional (contacto mostrado). Regenera la base al cambiarlos.
CORREO_PRUEBA_1=
CORREO_PRUEBA_2=
CORREO_PRUEBA_3=
CORREO_PRUEBA_4=
CORREO_PRUEBA_5=
NOMBRE_PRUEBA_1=
NOMBRE_PRUEBA_2=
NOMBRE_PRUEBA_3=
NOMBRE_PRUEBA_4=
NOMBRE_PRUEBA_5=

# Correo del EJECUTIVO de los clientes de tu slot (mismo número que tu CORREO_PRUEBA_n).
# Ahí llega el aviso de los casos que el chat deriva, con NOTIFICAR_DERIVACIONES=true y
# CORREO_DERIVACIONES vacío. Solo cambia el correo (el nombre del ejecutivo se mantiene).
#   slot 1 -> Jorge Salazar | 2 -> Lucía Paredes | 3 -> Diego Quispe | 4 -> Rosa Huamán | 5 -> Carla Mendoza
# Vacío = @anticipa.example (no recibe). Regenera la base al cambiarlos.
CORREO_EJECUTIVO_1=
CORREO_EJECUTIVO_2=
CORREO_EJECUTIVO_3=
CORREO_EJECUTIVO_4=
CORREO_EJECUTIVO_5=

OTP_MINUTOS_VALIDEZ=10
OTP_MAX_INTENTOS=3
OTP_ESPERA_REENVIO_SEG=60

# Secreto para el HMAC del código OTP y para firmar el token de sesión (JWT).
# Genera uno propio, no lo compartas ni lo versiones:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarlo invalida las sesiones abiertas y los códigos pendientes.
AUTH_SECRET=
# Duración de la sesión tras verificar el código (minutos). Sin logout por ahora.
AUTH_MINUTOS_SESION=30

# Aviso por correo al registrar y derivar un caso (POST /mi/casos).
# El caso y el resultado del aviso quedan SIEMPRE en interaccion_log.
# Con NOTIFICAR_DERIVACIONES=true el correo va al ejecutivo del cliente, salvo:
# - CORREO_DERIVACIONES definido y ENTORNO=dev: se redirige a esa casilla de prueba
#   (el correo dice a quién iba). Fuera de dev SE IGNORA y el aviso va al ejecutivo real.
#   Para recibir el aviso como "tu" ejecutivo, mejor CORREO_EJECUTIVO_n (arriba).
# - Dominios reservados (.example, .test, ...): no se envía, porque rebotaría.
# Si falla el SMTP, el caso se registra igual.
NOTIFICAR_DERIVACIONES=false
CORREO_DERIVACIONES=

# Entorno: "dev" expone el CRUD de desarrollo /api/... SIN autenticación (Postman).
# Cualquier otro valor, o no definirlo, lo oculta: quedan /health, /auth y /mi.
ENTORNO=dev

# Límite de solicitudes de código por IP: máximo N en una ventana de X segundos.
AUTH_MAX_SOLICITUDES_POR_IP=5
AUTH_VENTANA_SOLICITUDES_SEG=900

# --- Modelo de lenguaje (app/llm, router del curso) ---
# Cualquier endpoint compatible. Respaldos: LLM_2_BASE_URL / LLM_2_API_KEY / LLM_2_MODEL ... LLM_9_*
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT=120

# --- RAG (app/rag) ---
# PDF de docs/ que se indexan (separados por coma). faq.json no entra al índice.
RAG_PDFS=Anticipa_01_Identidad_y_Atencion.pdf,Anticipa_03_Politicas_Catalogo_Glosario.pdf
RAG_CATALOGO=catalogo.json
# auto = embeddings locales y, si no están, TF-IDF | denso | tfidf
RAG_MOTOR=auto
# Se descarga una vez (~195 MB) a la caché de Hugging Face
SENTENCE_TRANSFORMER_MODEL=ibm-granite/granite-embedding-97m-multilingual-r2
# Escala del modelo denso: relevantes ~0.83-0.96, ajenas ~0.74-0.81 (calibrar)
RAG_UMBRAL=0.82
RAG_UMBRAL_TFIDF=0.08
RAG_K_INICIAL=8
RAG_K_FINAL=3
# 1.0 = solo relevancia, 0.0 = solo variedad
RAG_MMR_LAMBDA=0.5
CHUNK_MAX_PALABRAS=150
CHUNK_OVERLAP_PALABRAS=25
# Cargar el índice al arrancar la API (en segundo plano) y no en el primer mensaje
RAG_PRECARGAR=true

# --- Chat (app/agente) ---
# Llamadas al modelo por turno como máximo (cada herramienta usada suma una)
CHAT_MAX_VUELTAS=3
# Mensajes previos que se reenvían en cada turno (más = más tokens)
CHAT_MAX_MENSAJES=8
CHAT_MAX_TOKENS=600
CHAT_TEMPERATURA=0.3
