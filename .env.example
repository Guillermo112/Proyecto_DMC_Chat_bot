# Copia este archivo como .env (en la raíz del proyecto) y ajusta los valores.
# .env no se versiona; no pongas secretos en .env.example.

# Ruta de la base SQLite (relativa a la raíz del proyecto o absoluta)
ANTICIPA_DB_PATH=db/anticipa.db

# Paginación de listar_facturas
LIMITE_POR_DEFECTO=20
LIMITE_MAXIMO=100

# SMTP para enviar el código OTP (ej. Gmail: smtp.gmail.com, 587 y una
# "contraseña de aplicación" de 16 caracteres, no la contraseña normal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=

# Correos reales que generar_datos.py asigna a los clientes de prueba para
# recibir el OTP (CORREO_PRUEBA_1 -> clientes 1-7, CORREO_PRUEBA_2 -> 8-13).
# Vacío = correos ficticios .example. Regenera la base al cambiarlos.
CORREO_PRUEBA_1=
CORREO_PRUEBA_2=

OTP_MINUTOS_VALIDEZ=10
OTP_MAX_INTENTOS=3
OTP_ESPERA_REENVIO_SEG=60
